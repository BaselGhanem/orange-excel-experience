rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orangeExcelAssessments/{assessmentId} {
      // Workshop setup: participants submit; trainer dashboard reads/edits/deletes.
      // The 2505 PIN is a client-side UI gate, not Firebase Authentication.
      allow create, read, update, delete: if true;
    }

    match /orangeExcelConfig/{configId} {
      // Site/assessment live controls used by the trainer dashboard and participant pages.
      // Kept permissive for this closed training event; move writes behind Firebase Auth for permanent use.
      allow read, create, update, delete: if true;
    }
  }
}
