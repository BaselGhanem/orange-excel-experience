rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orangeExcelAssessments/{assessmentId} {
      // Lightweight workshop setup:
      // participants can save/update their deterministic Pre/Post document;
      // trainer pages can read/edit/delete results.
      // IMPORTANT: the 2505 PIN is a client-side UI gate, not Firebase Authentication.
      // These rules are intentionally permissive for the training event.
      allow create, read, update, delete: if true;
    }
  }
}
